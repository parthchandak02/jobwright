# git-secrets false positives for jobwright (no secret values)
os\.environ
env=env
CLAUDECODE
CLAUDE_CODE_ENTRYPOINT
GEMINI_API_KEY
CURSOR_API_KEY
CAPSOLVER_API_KEY
\.env
jobwright/\.env
~/.jobwright/
ENV_PATH
\*\.env
\.env\.\*
# Benign 'env'/'venv' word usage flagged by the broad .env pattern (no secret values)
env-specific
env names
\.venv
Interpreter / venv
env = f"JOBWRIGHT_USER
deliver, env]
target: env > user registry
env\["PYTHONUNBUFFERED"\]
# Benign PM2/venv config tokens (no secret values)
env: \{
venv
env\["JOBWRIGHT_LOG_LEVEL"\]
env\.get\("JOBWRIGHT_LOG_LEVEL"
env\["JOBWRIGHT_WEB_RUN_ID"\]
extra_env
env\.update\(extra_env\)
env\.setdefault\("JOBWRIGHT_LOG_LEVEL"
env\.setdefault\("APPLY_PREP_LIMIT"
env\.setdefault\("APPLY_MIN_SCORE"
env\.setdefault\("HERMES_ACCEPT_HOOKS"
