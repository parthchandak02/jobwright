# git-secrets false positives for applypilot-agent (no secret values)
os\.environ
env=env
CLAUDECODE
CLAUDE_CODE_ENTRYPOINT
GEMINI_API_KEY
CURSOR_API_KEY
CAPSOLVER_API_KEY
\.env
applypilot/\.env
~/.applypilot/
ENV_PATH
\*\.env
\.env\.\*
# Benign 'env'/'venv' word usage flagged by the broad .env pattern (no secret values)
env-specific
env names
\.venv
Interpreter / venv
env = f"APPLYPILOT_USER
deliver, env]
