# jobwright environment. Copy to a single .env at the repo root (gitignored).
# Shared by every profile; a profile may add a users/<id>/.env overlay
# (e.g. TYPESAFE_API_KEY) that only that profile's CLI runs see.

# --- LLM (first match wins) -------------------------------------------------
FIREWORKS_API_KEY=
# LLM_MODEL=accounts/fireworks/models/glm-5p3-flash   # default; gpt-oss is banned
# GEMINI_API_KEY=                 # failover when the primary returns empty content
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# GEMINI_THINKING_LEVEL=low       # minimal|low|medium|high (Gemini 3.x)
# OPENAI_API_KEY=
# LLM_URL=http://127.0.0.1:8080/v1

# --- Scoring v2 (docs/adr/ADR-006) ------------------------------------------
# JOBWRIGHT_SCORE_WORKERS=16       # concurrent scoring calls (halved automatically on a 429, recovers slowly)
# JOBWRIGHT_LLM_STRUCTURED_ATTEMPTS=6 # attempts per scoring call on 429/5xx (jittered backoff, honors Retry-After, max 60s)
# LLM_ESCALATION_MODEL=            # opt-in stronger tier for borderline jobs (off by default)
# JOBWRIGHT_REASONING_T1=low       # hidden-reasoning budget for the cheap tier
# JOBWRIGHT_SCORER=v2              # v1 = legacy single-number scorer (rollback)
# Keep the single quotes: cron scripts `source` this file in bash, and unquoted JSON kills every brief.
# JOBWRIGHT_LLM_PRICES='{"accounts/fireworks/models/glm-5p3-flash": [0.15, 0.50, 0.03]}'  # USD per 1M input, output, cached input (Fireworks Standard, 2026-09-28)
# JOBWRIGHT_BRIEF_MAX_AGE_DAYS=7   # notify only jobs discovered this recently

# --- Dashboard auth (docs/adr/ADR-005) --------------------------------------
# Production (pm2) sets JOBWRIGHT_AUTH_MODE=cloudflare; these two identify the Access app.
JOBWRIGHT_CF_TEAM_DOMAIN=
JOBWRIGHT_CF_AUD=
# JOBWRIGHT_ADMIN_EMAILS=          # extra admins besides users.yaml `admins`
# Access allowlist sync (`jobwright access sync`, Admin page): keeps the "jobwright users" policy = users.yaml emails + admins.
# CLOUDFLARE_API_TOKEN=            # scope: Account > Access: Apps and Policies > Edit
# CLOUDFLARE_ACCOUNT_ID=           # default: accountID from ~/.cloudflared/cert.pem
# JOBWRIGHT_CF_HOSTNAME=jobwright.parthchandak.info   # app lookup when JOBWRIGHT_CF_AUD is unset
# JOBWRIGHT_PUBLIC_BASE_URL=https://jobwright.parthchandak.info   # deep links in WhatsApp

# --- Ops (docs/adr/ADR-007) -------------------------------------------------
# JOBWRIGHT_BACKUP_DIR=/Volumes/ExternalSSD/Backups/jobwright   # nightly snapshots
# JOBWRIGHT_OPS_TARGET=           # overrides users.yaml ops_target for alerts
# JOBWRIGHT_OPS_HEARTBEAT=1       # also message the operator when a brief is OK
# JOBWRIGHT_HERMES_DRY_RUN=1      # sandboxes: never create crons or send WhatsApp
# Second alert channel that does not depend on Hermes, used when an ops alert
# cannot go out through `hermes send` (bridge down) or no ops target is set.
# Comma-separated: macos (Notification Center via osascript), an ntfy topic URL
# (https://ntfy.sh/<long-random-topic> or a self-hosted server; anyone who knows
# a public topic can read it, so make it unguessable), or off.
# Unset = macos on macOS, nothing elsewhere.
# JOBWRIGHT_OPS_FALLBACK=macos,https://ntfy.sh/<long-random-topic>
# JOBWRIGHT_OPS_NTFY_TOKEN=       # optional bearer token for a protected ntfy topic
# JOBWRIGHT_NOTIFY_RETRIES=3      # watchdog re-sends of a failed daily list per day (once the bridge is healthy)
# JOBWRIGHT_BRIEF_TIMEOUT=10800   # hard deadline (s) for preflight + pipeline; the run is killed, notify + report still run
# JOBWRIGHT_NOTIFY_TIMEOUT=300    # hard limit (s) for the brief's notify step
# JOBWRIGHT_STAGE_BUDGET_ENRICH=2700   # soft budget (s): enrich stops early and leaves the rest for the next run
# JOBWRIGHT_STAGE_BUDGET_<STAGE>=      # soft budget for any other stage (logged as over budget; no default)

# --- Discovery --------------------------------------------------------------
# DISCOVER_MODE=fast              # fast (daily) | full (weekly deep crawl with smart-extract)
# JOBWRIGHT_DISCOVER_WORKERS=4
# JOBWRIGHT_LINKEDIN=guest        # guest (paced jobs-guest client) | jobspy (old JobSpy LinkedIn scraper)
# JOBWRIGHT_LINKEDIN_INTERVAL=0.5 # fastest spacing between LinkedIn requests (shared; widens on 429)
# JOBWRIGHT_SITE_BLOCK_THRESHOLD=3 # blocked responses (403 / give-up 429) in a row before a board is skipped for the run
# JOBWRIGHT_SITE_COOLDOWN_DAYS=3  # a board blocked all run is skipped this many days, then probed once (logs/site_cooldown.json)
# JOBWRIGHT_HOURS_OLD=72
# JOBWRIGHT_CONNECT_LIMIT=15      # jobs per run that get connection research
# EXA_API_KEY=                    # web research for "who you know there"

# --- Apply (docs/agents/auto-apply.md; dry-run unless --live / apply due) ------
# Needs the optional extra: uv sync --extra apply (anthropic SDK).
ANTHROPIC_API_KEY=
AGENT_PROVIDER=anthropic          # anthropic | legacy (dry-run only): cursor-sdk, cursor-cli, claude
# JOBWRIGHT_APPLY_MODEL=claude-sonnet-5-5
# JOBWRIGHT_APPLY_EFFORT=medium
# JOBWRIGHT_APPLY_FALLBACKS=on    # server-side refusal fallbacks; off disables
# JOBWRIGHT_APPLY_MAX_STEPS=60    # tool calls per application
# JOBWRIGHT_APPLY_TIMEOUT_S=900   # wall clock per application (time waiting for a person not counted)
# JOBWRIGHT_APPLY_WAIT_MINUTES=20 # how long a run waits for a CAPTCHA / email code
# JOBWRIGHT_APPLY_HEADLESS=       # default: headless for dry runs, a visible window for live runs
# JOBWRIGHT_APPLY_EXTRA_HOSTS=    # extra allowlisted hosts (comma-separated)
# JOBWRIGHT_APPLY_FILLERS=on      # deterministic Greenhouse/Lever/Ashby fillers first
# JOBWRIGHT_APPLY_KILL=           # any value: stop every application (dry runs too)
# JOBWRIGHT_HERMES_MEDIA=on       # attach screenshots to the "Applied today" report (hermes MEDIA:)
# Legacy cursor providers (dry-run only):
# CURSOR_API_KEY=
# APPLY_AGENT_MODEL=composer-2.5
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
