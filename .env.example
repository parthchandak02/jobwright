# jobwright Environment Configuration
# Copy to a single .env at the repo root (gitignored). Shared by all profiles.

# LLM Provider for stages 1-5 (first match wins)
FIREWORKS_API_KEY=
# GEMINI_API_KEY=                 # runtime failover when Fireworks returns empty
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# GEMINI_THINKING_LEVEL=low       # minimal|low|medium|high (Gemini 3.x)
# OPENAI_API_KEY=
# LLM_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731

# Stage 6: Cursor Agent (default)
CURSOR_API_KEY=
AGENT_PROVIDER=cursor-sdk
APPLY_AGENT_MODEL=composer-2.5

# Safety gates (flip APPLY_DRY_RUN=false only after 10 successful dry-runs)
APPLY_DRY_RUN=true
APPLY_MIN_SCORE=7
APPLY_MAX_WORKERS=2
APPLY_LIMIT=5

# Optional
CAPSOLVER_API_KEY=
# EXA_API_KEY=   # optional: web research for per-job connections in Daily Brief
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# JOBWRIGHT_DIR=~/.jobwright

# Discover speed: fast (default cron) = JobSpy + Workday tier-1, skip smart-extract.
# full = all query tiers + smart-extract (use for weekly deep crawl).
# SCORE_BATCH_SIZE=10   # jobs per scoring LLM call (1 = sequential; do not dump the full DB)

# Legacy Claude Code provider (set AGENT_PROVIDER=claude)
# Requires claude CLI on PATH (not needed for cursor-sdk)
