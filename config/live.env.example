# Live apply configuration — enable only after dry-run validation
# Merge into repo-root .env when ready (and set apply_enabled for the user).

APPLY_DRY_RUN=false
APPLY_MIN_SCORE=7
APPLY_MAX_WORKERS=2
APPLY_LIMIT=5
AGENT_PROVIDER=cursor-sdk
APPLY_AGENT_MODEL=composer-2.5

# Live apply is NOT a cron. WhatsApp users: CONFIRM APPLY → jobwright_confirm.sh + jobwright_on_confirm.sh
# Daily Brief crons (find-only by default): jobwright-brief / jobwright-send / jobwright-check
