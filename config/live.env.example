# Live apply configuration — enable only after dry-run validation
# Merge into repo-root .env when ready (and set apply_enabled for the user).

APPLY_DRY_RUN=false
APPLY_MIN_SCORE=7
APPLY_MAX_WORKERS=2
APPLY_LIMIT=5
AGENT_PROVIDER=cursor-sdk
APPLY_AGENT_MODEL=composer-2.5

# Optional Gemini failover (also set in repo-root .env):
# GEMINI_API_KEY=
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# GEMINI_THINKING_LEVEL=low

# Live apply is NOT a cron. Trigger it from the dashboard apply button (confirm
# gate + apply_enabled) or run: jobwright --user <id> apply --live
# Daily Brief cron (find-only by default): jobwright-brief-<user> (pipeline + notify)
